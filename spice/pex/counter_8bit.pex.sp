*
*
*********add the following lines **********
.lib "PTM180.l" cmos
.MALIAS nmos=nch
.MALIAS pmos=pch

xcounter_8bit  CLK CNT<7> CNT<6> CNT<5> CNT<4> CNT<3> CNT<2> CNT<1> CNT<0> VDD! VSS! counter_8bit

vdd vdd! 0 1.8
vss vss! 0 0

VCLK   CLK    0  PULSE(0   1.8  2n  0.1n  0.1n  0.8n  2n)

*.ic V(cnt<0>)=1.8 V(CNT<1>)=1.8 V(CNT<2>)=1.8 V(CNT<3>)=1.8 V(CNT<4>)=1.8 V(CNT<5>)=1.8 V(CNT<6>)=1.8 V(CNT<7>)=1.8
.ic V(cnt<0>)=0 V(CNT<1>)=0 V(CNT<2>)=0 V(CNT<3>)=0 V(CNT<4>)=0 V(CNT<5>)=0 V(CNT<6>)=0 V(CNT<7>)=0

.trans 1ps 512ns

.option post=2
.end